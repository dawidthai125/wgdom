# Skopiuj do .env i uzupełnij (lokalny dev).
# W Vercel: Project → Settings → Environment Variables (te same nazwy).

# Supabase → Project Settings → General → Project ID
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase → Project Settings → API → anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Nazwa Edge Function (domyślnie make-server-0afb8820)
VITE_SUPABASE_FUNCTION_SLUG=make-server-0afb8820

# --- Tylko na Supabase (Edge Functions), NIE w Vercel frontend ---
# RESEND_API_KEY=        → Supabase Dashboard → Edge Functions → Secrets
# SUPABASE_SERVICE_ROLE_KEY= → ustawiane automatycznie przez Supabase
